# Copiez ce fichier vers .env et remplacez la valeur.
# Ne publiez jamais votre clé API ni le fichier .env.
REMOVE_BG_API_KEY=remplacez_par_votre_cle_remove_bg
PORT=3000
# preview réduit la résolution et peut bénéficier du quota de prévisualisations.
# auto ou full peuvent consommer des crédits supplémentaires.
REMOVE_BG_SIZE=preview
MAX_REQUESTS_PER_HOUR=30
# En production derrière un proxy HTTPS, renseignez l'origine exacte sans slash final.
# PUBLIC_ORIGIN=https://votre-domaine.fr
